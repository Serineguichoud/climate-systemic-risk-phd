
# ============================================================
# STOCHASTIC CLIMATE STRESS TEST WITH SECTORAL NOISE
# Median trajectory + uncertainty band
# ============================================================

library(dplyr)
library(tidyr)
library(ggplot2)
library(purrr)

sector_sigma <- tibble(
  Type...9 = c("coal", "oil/gas", "bioenergy"),
  sigma_s = c(0.30, 0.20, 0.15)
)

alpha_mu <- 0.05
n_sim <- 500

set.seed(123)

stress_base <- rx5day_exposure %>%
  filter(year >= 2015, year <= 2050) %>%
  left_join(sector_sigma, by = "Type...9") %>%
  mutate(
    g = log(rx5day / rx5day_baseline_1995_2014),
    mu_g = alpha_mu * g,
    t = year - 2015
  )

simulate_stress <- function(sim_id) {
  
  stress_base %>%
    mutate(
      sim = sim_id,
      W_t = rnorm(n(), mean = 0, sd = sqrt(pmax(t, 0))),
      ST = exp(
        (mu_g - 0.5 * sigma_s^2) * t +
          sigma_s * W_t
      )
    )
}

stress_simulations <- map_dfr(1:n_sim, simulate_stress)

stress_summary <- stress_simulations %>%
  group_by(scenario, year, sim) %>%
  summarise(
    ST_weighted = weighted.mean(ST, capacity_mw, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  group_by(scenario, year) %>%
  summarise(
    ST_median = median(ST_weighted, na.rm = TRUE),
    ST_p05 = quantile(ST_weighted, 0.05, na.rm = TRUE),
    ST_p95 = quantile(ST_weighted, 0.95, na.rm = TRUE),
    .groups = "drop"
  )

ggplot(stress_summary, aes(x = year, color = scenario, fill = scenario)) +
  geom_ribbon(
    aes(ymin = ST_p05, ymax = ST_p95),
    alpha = 0.15,
    color = NA
  ) +
  geom_line(
    aes(y = ST_median),
    linewidth = 1.1
  ) +
  labs(
    title = "Stochastic climate stress trajectories across ENGIE assets",
    subtitle = "Median and 5–95% interval from sectoral Brownian volatility",
    x = "Year",
    y = "Capacity-weighted ST(t)",
    color = "Scenario",
    fill = "Scenario"
  ) +
  theme_minimal(base_size = 14)

write.csv(
  stress_summary,
  "data_processed/stochastic_stress_summary_sectoral_noise.csv",
  row.names = FALSE
)

ggsave(
  "data_processed/stochastic_stress_summary_sectoral_noise.png",
  width = 11,
  height = 6,
  dpi = 300
)

