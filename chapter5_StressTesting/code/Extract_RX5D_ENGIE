# ------------------------------------------------------------
# 4. Find RX5day NetCDF files
# ------------------------------------------------------------

find_rx5day_file <- function(scenario) {
  
  keys <- test_keys
  
  selected <- keys %>%
    str_subset(scenario) %>%
    str_subset("rx5day") %>%
    str_subset("\\.nc$")
  
  if (scenario == "historical") {
    selected <- selected %>%
      str_subset("historical")
  }
  
  if (scenario != "historical") {
    selected <- selected %>%
      str_subset("2015|2100|2040|2059|annual|timeseries")
  }
  
  # Prefer annual timeseries if available
  annual_timeseries <- selected %>%
    str_subset("annual") %>%
    str_subset("timeseries")
  
  if (length(annual_timeseries) > 0) {
    selected <- annual_timeseries
  }
  
  # Prefer ensemble median if available
  median_file <- selected[str_detect(selected, "median")]
  
  if (length(median_file) > 0) {
    selected <- median_file[1]
  } else {
    selected <- selected[1]
  }
  
  if (length(selected) == 0 || is.na(selected)) {
    stop(paste("No RX5day file found for scenario:", scenario))
  }
  
  selected
}

