# ------------------------------------------------------------
# 7. Function to extract RX5day
# ------------------------------------------------------------

extract_rx5day <- function(nc_file, scenario_name, points_df, points_vect) {
  
  message("Extracting scenario: ", scenario_name)
  
  r <- rast(nc_file)
  
  # Try to recover years from raster time dimension
  raster_time <- try(time(r), silent = TRUE)
  
  if (!inherits(raster_time, "try-error") &&
      !all(is.na(raster_time))) {
    
    years <- as.numeric(format(raster_time, "%Y"))
    
  } else {
    
    layer_names <- names(r)
    years <- as.numeric(str_extract(layer_names, "\\d{4}"))
  }
  
  keep_layers <- which(years %in% years_keep)
  
  if (length(keep_layers) == 0) {
    warning(
      paste(
        "No matching years found for",
        scenario_name,
        "- keeping all layers."
      )
    )
    keep_layers <- seq_len(nlyr(r))
    years_selected <- years
  } else {
    years_selected <- years[keep_layers]
  }
  
  r <- r[[keep_layers]]
  
  vals <- terra::extract(r, points_vect)
  
  vals <- vals %>%
    select(-ID) %>%
    mutate(asset_point_id = points_df$asset_point_id)
  
  names(vals)[names(vals) != "asset_point_id"] <- paste0(
    "year_",
    years_selected
  )
  
  vals_long <- vals %>%
    pivot_longer(
      cols = starts_with("year_"),
      names_to = "year",
      values_to = "rx5day"
    ) %>%
    mutate(
      year = as.numeric(str_remove(year, "year_")),
      scenario = scenario_name
    ) %>%
    filter(year %in% years_keep)
  
  vals_long
}

