# ------------------------------------------------------------
# 2. Function to list files from public CCKP bucket
# ------------------------------------------------------------

list_s3_keys <- function(prefix) {
  
  keys <- c()
  continuation_token <- NULL
  
  repeat {
    
    url <- paste0(
      bucket_url,
      "/?list-type=2&prefix=",
      URLencode(prefix, reserved = TRUE)
    )
    
    if (!is.null(continuation_token)) {
      url <- paste0(
        url,
        "&continuation-token=",
        URLencode(continuation_token, reserved = TRUE)
      )
    }
    
    resp <- request(url) %>% req_perform()
    xml <- resp_body_xml(resp)
    
    new_keys <- xml_find_all(xml, "//*[local-name()='Key']") %>%
      xml_text()
    
    keys <- c(keys, new_keys)
    
    is_truncated <- xml_find_first(
      xml,
      "//*[local-name()='IsTruncated']"
    ) %>%
      xml_text()
    
    if (length(is_truncated) == 0 ||
        is.na(is_truncated) ||
        is_truncated != "true") {
      break
    }
    
    continuation_token <- xml_find_first(
      xml,
      "//*[local-name()='NextContinuationToken']"
    ) %>%
      xml_text()
  }
  
  keys
}

